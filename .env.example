# Token de votre bot Discord (depuis Discord Developer Portal)
DISCORD_BOT_TOKEN=ton_token_ici

# ID du salon où le bot enverra les demandes d'approbation (clic droit → Copier l'ID)
DISCORD_APPROVAL_CHANNEL=

# URL publique de votre serveur (pour les liens éventuels, ici utilisée uniquement pour les routes API)
BASE_URL=

# Port d'écoute du serveur web
PORT=3000

# (Optionnel) URL d'un webhook Discord en fallback si le bot est down
# Crée-le dans Paramètres du salon → Intégrations → Webhooks
DISCORD_WEBHOOK_URL=
