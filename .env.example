# ==========================================
# BOT DISCORD
# ==========================================

# Token de votre bot Discord (Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=ton_token_ici

# ID du salon où le bot enverra les demandes d'approbation (clic droit → Copier l'ID)
DISCORD_APPROVAL_CHANNEL=

# (Optionnel) URL d'un webhook Discord en fallback si le bot est down
DISCORD_WEBHOOK_URL=

# ==========================================
# SERVEUR
# ==========================================

# URL publique de votre serveur (ex: https://snap-ivh7.onrender.com)
BASE_URL=

# Port d'écoute du serveur web
PORT=3000

# ==========================================
# DASHBOARD (Discord OAuth2)
# ==========================================
# Crée une application sur https://discord.com/developers/applications
# → OAuth2 → ajoute l'URL de redirect : https://ton-domaine.com/auth/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Clé secrète pour les sessions (n'importe quelle chaîne aléatoire longue)
SESSION_SECRET=change_moi_avec_une_chaine_aleatoire_longue

# ==========================================
# ABONNEMENTS STRIPE (3€/mois)
# ==========================================
# Crée un compte sur https://stripe.com
# → Produits → crée un produit 3€/mois → copie l'ID du prix (price_xxx)
# → Développeurs → Clés API → copie la clé secrète
# → Développeurs → Webhooks → ajoute https://ton-domaine.com/api/stripe/webhook
#    Events à écouter : checkout.session.completed, customer.subscription.deleted

STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
